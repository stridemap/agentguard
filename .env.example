# ── AgentGuard Configuration ────────────────────────
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# LLM Provider: ollama | openai | anthropic (default: ollama)
AGENTGUARD_LLM_PROVIDER=ollama

# API keys (only needed if using cloud LLM providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Database URL — SQLite for local dev, PostgreSQL for production
# SQLite:      sqlite:///agentguard.db
# PostgreSQL:  postgresql+asyncpg://user:pass@localhost:5432/agentguard
DATABASE_URL=sqlite:///agentguard.db

# Application secret (used for JWT signing in Sprint 5+)
SECRET_KEY=change-me-to-a-random-string

# Logging level: DEBUG | INFO | WARNING | ERROR
AGENTGUARD_LOG_LEVEL=INFO

# Path to policy YAML directory
AGENTGUARD_POLICY_PATH=policies/

# Streamlit dashboard port
STREAMLIT_SERVER_PORT=8501

# SIEM webhook URL (Sprint 7+) — leave empty to disable
AGENTGUARD_SIEM_WEBHOOK_URL=
