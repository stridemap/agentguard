# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
.venv/
venv/
env/
.python-version

# ── Node / Next.js ─────────────────────────────────
node_modules/
web/.next/
web/out/
.vercel
.turbo

# ── Environment & Secrets ──────────────────────────
.env
.env.local
.env.*.local
.env.production
*.pem
*.key

# ── IDE ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# ── OS ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Testing & Coverage ─────────────────────────────
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Streamlit ──────────────────────────────────────
dashboard/.streamlit/secrets.toml

# ── Database (local dev) ───────────────────────────
*.db
*.sqlite
*.sqlite3
# Hand-made copies taken before a migration or a fix keep the data but lose the
# bare .db suffix, so they slip past the rules above.
*.db.*

# ── Docs (private — not published to GitHub) ──────
# ADRs are the exception: decision records must be version-controlled.
docs/*
!docs/adr/

# ── Misc ───────────────────────────────────────────
*.log
*.bak
*.tmp
web/tsconfig.tsbuildinfo

# ── Marketing & demo scaffolding (private — not published) ─
# The a16z Speedrun suite: ~1 GB of assets, built pitch material and vendored
# dependencies. It consumes agentguard as-shipped and is not part of the library.
marketing/
